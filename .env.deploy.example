# Скопируйте в .env.deploy и заполните. Файл в git не попадает.

# ID развёртывания, которое обновляем. Адрес /exec у него не меняется,
# поэтому вебхук переставлять не нужно.
# Взять: npm run deployments — либо в редакторе «Управление развёртываниями».
DEPLOYMENT_ID=

# Адрес этого же развёртывания, для проверки после отправки кода.
WEBAPP_URL=

# Не обязательно: с ним проверка покажет ещё и состояние вебхука.
# Значение — свойство скрипта WEBHOOK_SECRET.
WEBHOOK_SECRET=
